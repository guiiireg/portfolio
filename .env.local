# EmailJS Configuration
# Pour configurer EmailJS, suivez les instructions dans EMAILJS_SETUP.md

# 1. Service ID - Obtenez-le depuis EmailJS Dashboard > Email Services
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_yeoag65

# 2. Template ID - Obtenez-le depuis EmailJS Dashboard > Email Templates
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_dnz1hdb

# 3. Public Key (User ID) - Obtenez-le depuis EmailJS Dashboard > Account > General
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=jrT4CV2RJSVZT83lJ

# ⚠️ IMPORTANT :
# - Remplacez les valeurs ci-dessus par vos propres clés EmailJS
